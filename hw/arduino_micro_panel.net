(export (version D)
  (design
    (source "arduino_micro_panel.sch")
    (date "2026-09-17")
    (tool "arduino_micro_panel-netlist-export")
    (sheet (number 1) (name /) (tstamp 00000000) (title "Arduino Micro Control Panel") (comment "Netlist export of arduino_micro_panel.ino pin mapping"))
  )
  (components
    (comp (ref U1)
      (value "Arduino Micro")
      (footprint "Module:Arduino_Micro")
      (libsource (lib "conn") (part "Arduino_Micro") (description "Arduino Micro (ATmega32u4)"))
      (sheetpath (names /) (tstamp 00000001))
      (tstamp 00000001))
    (comp (ref U2)
      (value "SSD1306 OLED 128x64")
      (footprint "Module:OLED_0.96_128x64_I2C")
      (libsource (lib "display") (part "SSD1306_I2C") (description "0.96 inch OLED, I2C, addr 0x3C"))
      (sheetpath (names /) (tstamp 00000002))
      (tstamp 00000002))
    (comp (ref SW1)
      (value "SW1")
      (footprint "Button_Switch:SW_Push_1P1T_NO_6x6_THT")
      (libsource (lib "switch") (part "SW_Push") (description "Momentary pushbutton, active LOW w/ INPUT_PULLUP"))
      (sheetpath (names /) (tstamp 00000003))
      (tstamp 00000003))
    (comp (ref SW2)
      (value "SW2")
      (footprint "Button_Switch:SW_Push_1P1T_NO_6x6_THT")
      (libsource (lib "switch") (part "SW_Push") (description "Momentary pushbutton, active LOW w/ INPUT_PULLUP"))
      (sheetpath (names /) (tstamp 00000004))
      (tstamp 00000004))
    (comp (ref SW3)
      (value "SW3")
      (footprint "Button_Switch:SW_Push_1P1T_NO_6x6_THT")
      (libsource (lib "switch") (part "SW_Push") (description "Momentary pushbutton, active LOW w/ INPUT_PULLUP"))
      (sheetpath (names /) (tstamp 00000005))
      (tstamp 00000005))
    (comp (ref SW4)
      (value "SW4")
      (footprint "Button_Switch:SW_Push_1P1T_NO_6x6_THT")
      (libsource (lib "switch") (part "SW_Push") (description "Momentary pushbutton, active LOW w/ INPUT_PULLUP"))
      (sheetpath (names /) (tstamp 00000006))
      (tstamp 00000006))
    (comp (ref ENC1)
      (value "Rotary Encoder 1")
      (footprint "Rotary_Encoder:RotaryEncoder_Alps_EC11")
      (libsource (lib "device") (part "Rotary_Encoder") (description "Incremental rotary encoder, CLK/DT/SW"))
      (sheetpath (names /) (tstamp 00000007))
      (tstamp 00000007))
    (comp (ref ENC2)
      (value "Rotary Encoder 2")
      (footprint "Rotary_Encoder:RotaryEncoder_Alps_EC11")
      (libsource (lib "device") (part "Rotary_Encoder") (description "Incremental rotary encoder, CLK/DT/SW"))
      (sheetpath (names /) (tstamp 00000008))
      (tstamp 00000008))
  )
  (nets
    (net (code "1") (name "+5V")
      (node (ref U1) (pin "5V"))
      (node (ref U2) (pin VCC))
      (node (ref ENC1) (pin VCC))
      (node (ref ENC2) (pin VCC)))
    (net (code "2") (name "GND")
      (node (ref U1) (pin "GND"))
      (node (ref U2) (pin GND))
      (node (ref SW1) (pin "1"))
      (node (ref SW2) (pin "1"))
      (node (ref SW3) (pin "1"))
      (node (ref SW4) (pin "1"))
      (node (ref ENC1) (pin GND))
      (node (ref ENC2) (pin GND)))
    (net (code "3") (name "D2")
      (node (ref U1) (pin "D2"))
      (node (ref U2) (pin SDA)))
    (net (code "4") (name "D3")
      (node (ref U1) (pin "D3"))
      (node (ref U2) (pin SCL)))
    (net (code "5") (name "D4")
      (node (ref U1) (pin "D4"))
      (node (ref SW1) (pin "2")))
    (net (code "6") (name "D5")
      (node (ref U1) (pin "D5"))
      (node (ref SW2) (pin "2")))
    (net (code "7") (name "D6")
      (node (ref U1) (pin "D6"))
      (node (ref SW3) (pin "2")))
    (net (code "8") (name "D7")
      (node (ref U1) (pin "D7"))
      (node (ref SW4) (pin "2")))
    (net (code "9") (name "D8")
      (node (ref U1) (pin "D8"))
      (node (ref ENC1) (pin CLK)))
    (net (code "10") (name "D9")
      (node (ref U1) (pin "D9"))
      (node (ref ENC1) (pin DT)))
    (net (code "11") (name "D10")
      (node (ref U1) (pin "D10"))
      (node (ref ENC2) (pin CLK)))
    (net (code "12") (name "D11")
      (node (ref U1) (pin "D11"))
      (node (ref ENC2) (pin DT)))
    (net (code "13") (name "D12")
      (node (ref U1) (pin "D12"))
      (node (ref ENC1) (pin SW)))
    (net (code "14") (name "D13")
      (node (ref U1) (pin "D13"))
      (node (ref ENC2) (pin SW)))
  )
)
