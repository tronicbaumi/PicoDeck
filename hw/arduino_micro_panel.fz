<?xml version="1.0" encoding="UTF-8"?>
<!--
  arduino_micro_panel.fz.xml
  Description-level Fritzing export for the Arduino Micro control panel.
  This is a plain XML description of parts and connections, NOT a real .fzz
  archive. It maps to standard Fritzing parts bin entries; see fritzing/README.md.
-->
<module fritzingVersion="0.9.6" moduleId="arduino_micro_panel">
  <title>Arduino Micro Control Panel</title>
  <description>
    Wiring description for the Arduino Micro control panel:
      - SSD1306 0.96" I2C OLED (addr 0x3C) on D2/D3
      - Two rotary encoders (ENC1 on D8/D9/D12, ENC2 on D10/D11/D13)
      - Four momentary buttons (SW1..SW4 on D4..D7)
    All inputs are wired with INPUT_PULLUP and read active-LOW.
  </description>

  <instances>
    <instance id="inst_u1"  moduleIdRef="part_arduino_micro"  name="U1"  />
    <instance id="inst_u2"  moduleIdRef="part_ssd1306_oled"  name="U2"  />
    <instance id="inst_sw1" moduleIdRef="part_pushbutton"    name="SW1" />
    <instance id="inst_sw2" moduleIdRef="part_pushbutton"    name="SW2" />
    <instance id="inst_sw3" moduleIdRef="part_pushbutton"    name="SW3" />
    <instance id="inst_sw4" moduleIdRef="part_pushbutton"    name="SW4" />
    <instance id="inst_enc1" moduleIdRef="part_rotary_encoder" name="ENC1" />
    <instance id="inst_enc2" moduleIdRef="part_rotary_encoder" name="ENC2" />
  </instances>

  <parts>
    <part id="part_arduino_micro" title="Arduino Micro" library="Sparkfun" partUrl="https://raw.githubusercontent.com/sparkfun/Arduino_Pro_Micro_3288/master/SparkFun/ProMicro.fzpz">
      <connectors>
        <connector id="c5v"    name="5V"     type="male"/>
        <connector id="cgnd"   name="GND"    type="male"/>
        <connector id="cd2"    name="D2"     type="male"/>
        <connector id="cd3"    name="D3"     type="male"/>
        <connector id="cd4"    name="D4"     type="male"/>
        <connector id="cd5"    name="D5"     type="male"/>
        <connector id="cd6"    name="D6"     type="male"/>
        <connector id="cd7"    name="D7"     type="male"/>
        <connector id="cd8"    name="D8"     type="male"/>
        <connector id="cd9"    name="D9"     type="male"/>
        <connector id="cd10"   name="D10"    type="male"/>
        <connector id="cd11"   name="D11"    type="male"/>
        <connector id="cd12"   name="D12"    type="male"/>
        <connector id="cd13"   name="D13"    type="male"/>
      </connectors>
    </part>

    <part id="part_ssd1306_oled" title="SSD1306 0.96 inch OLED 128x64 (I2C)" library="Adafruit" partUrl="https://raw.githubusercontent.com/adafruit/Fritzing-Library/master/parts/Adafruit_SSD1306_128x64.fzpz">
      <connectors>
        <connector id="oled_vcc"  name="VCC"  type="male"/>
        <connector id="oled_gnd"  name="GND"  type="male"/>
        <connector id="oled_sda"  name="SDA"  type="male"/>
        <connector id="oled_scl"  name="SCL"  type="male"/>
      </connectors>
    </part>

    <part id="part_pushbutton" title="Momentary Pushbutton (active-LOW)" library="Core" partUrl="generic_switch.fzp">
      <connectors>
        <connector id="btn_pin1" name="1" type="male"/>
        <connector id="btn_pin2" name="2" type="male"/>
      </connectors>
    </part>

    <part id="part_rotary_encoder" title="Rotary Encoder (EC11-style)" library="Sparkfun" partUrl="https://raw.githubusercontent.com/sparkfun/SparkFun-Eagle-Libraries/master/SparkFun/Parts/ROTARY_ENCODER.fzp">
      <connectors>
        <connector id="enc_vcc" name="VCC" type="male"/>
        <connector id="enc_gnd" name="GND" type="male"/>
        <connector id="enc_clk" name="CLK" type="male"/>
        <connector id="enc_dt"  name="DT"  type="male"/>
        <connector id="enc_sw"  name="SW"  type="male"/>
      </connectors>
    </part>
  </parts>

  <wires>
    <!-- OLED I2C -->
    <wire net="D2">
      <endpoint instance="inst_u1"  connectorId="cd2"     />
      <endpoint instance="inst_u2"  connectorId="oled_sda" />
    </wire>
    <wire net="D3">
      <endpoint instance="inst_u1"  connectorId="cd3"     />
      <endpoint instance="inst_u2"  connectorId="oled_scl" />
    </wire>

    <!-- OLED power -->
    <wire net="+5V">
      <endpoint instance="inst_u1"  connectorId="c5v"     />
      <endpoint instance="inst_u2"  connectorId="oled_vcc"/>
    </wire>
    <wire net="GND">
      <endpoint instance="inst_u1"  connectorId="cgnd"    />
      <endpoint instance="inst_u2"  connectorId="oled_gnd"/>
    </wire>

    <!-- Pushbuttons SW1..SW4 on D4..D7 (one leg to GND, the other to its pin) -->
    <wire net="D4">
      <endpoint instance="inst_u1"  connectorId="cd4"     />
      <endpoint instance="inst_sw1" connectorId="btn_pin2"/>
    </wire>
    <wire net="GND">
      <endpoint instance="inst_sw1" connectorId="btn_pin1"/>
    </wire>

    <wire net="D5">
      <endpoint instance="inst_u1"  connectorId="cd5"     />
      <endpoint instance="inst_sw2" connectorId="btn_pin2"/>
    </wire>
    <wire net="GND">
      <endpoint instance="inst_sw2" connectorId="btn_pin1"/>
    </wire>

    <wire net="D6">
      <endpoint instance="inst_u1"  connectorId="cd6"     />
      <endpoint instance="inst_sw3" connectorId="btn_pin2"/>
    </wire>
    <wire net="GND">
      <endpoint instance="inst_sw3" connectorId="btn_pin1"/>
    </wire>

    <wire net="D7">
      <endpoint instance="inst_u1"  connectorId="cd7"     />
      <endpoint instance="inst_sw4" connectorId="btn_pin2"/>
    </wire>
    <wire net="GND">
      <endpoint instance="inst_sw4" connectorId="btn_pin1"/>
    </wire>

    <!-- Encoder 1: CLK=D8, DT=D9, SW=D12 -->
    <wire net="D8">
      <endpoint instance="inst_u1"   connectorId="cd8"     />
      <endpoint instance="inst_enc1" connectorId="enc_clk"/>
    </wire>
    <wire net="D9">
      <endpoint instance="inst_u1"   connectorId="cd9"     />
      <endpoint instance="inst_enc1" connectorId="enc_dt" />
    </wire>
    <wire net="D12">
      <endpoint instance="inst_u1"   connectorId="cd12"    />
      <endpoint instance="inst_enc1" connectorId="enc_sw" />
    </wire>
    <wire net="+5V">
      <endpoint instance="inst_enc1" connectorId="enc_vcc"/>
    </wire>
    <wire net="GND">
      <endpoint instance="inst_enc1" connectorId="enc_gnd"/>
    </wire>

    <!-- Encoder 2: CLK=D10, DT=D11, SW=D13 -->
    <wire net="D10">
      <endpoint instance="inst_u1"   connectorId="cd10"    />
      <endpoint instance="inst_enc2" connectorId="enc_clk"/>
    </wire>
    <wire net="D11">
      <endpoint instance="inst_u1"   connectorId="cd11"    />
      <endpoint instance="inst_enc2" connectorId="enc_dt" />
    </wire>
    <wire net="D13">
      <endpoint instance="inst_u1"   connectorId="cd13"    />
      <endpoint instance="inst_enc2" connectorId="enc_sw" />
    </wire>
    <wire net="+5V">
      <endpoint instance="inst_enc2" connectorId="enc_vcc"/>
    </wire>
    <wire net="GND">
      <endpoint instance="inst_enc2" connectorId="enc_gnd"/>
    </wire>
  </wires>

  <labels>
    <label net="D2">OLED SDA</label>
    <label net="D3">OLED SCL</label>
    <label net="D4">SW1</label>
    <label net="D5">SW2</label>
    <label net="D6">SW3</label>
    <label net="D7">SW4</label>
    <label net="D8">ENC1.CLK</label>
    <label net="D9">ENC1.DT</label>
    <label net="D12">ENC1.SW</label>
    <label net="D10">ENC2.CLK</label>
    <label net="D11">ENC2.DT</label>
    <label net="D13">ENC2.SW</label>
  </labels>
</module>
